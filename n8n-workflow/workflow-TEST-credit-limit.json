        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $('Loop Over Titles').item.json.Title }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "gemini-existing-chat",
      "name": "Gemini Existing Chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5959/chat/grok",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $('Loop Over Titles').item.json.Title }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "grok-existing-chat",
      "name": "Grok Existing Chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "g1",
              "name": "geminiOutput",
              "type": "string",
              "value": "={{ $json.response ? $json.response : ($json.error ? ('(Gemini अपयशी: ' + JSON.stringify($json.error) + ')') : '') }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "rename-gemini",
      "name": "Rename Gemini Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        640,
        200
      ]
    },
    {
      "parameters": {
        "mode": "manual",
