              "value": "={{ $json.response ? $json.response : ($json.error ? ('(Grok अपयशी: ' + JSON.stringify($json.error) + ')') : '') }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "rename-grok",
      "name": "Rename Grok Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        640,
        400
      ]
    },
    {
      "parameters": {
        "mode": "combine",
