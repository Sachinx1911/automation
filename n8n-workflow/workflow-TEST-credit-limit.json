{
  "name": "[TEST] Credit-limit pause/resume (1 min wait)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "[TEST] Excel Upload",
        "formDescription": "Titles असलेली Excel फाईल अपलोड करा (Status = PENDING असलेल्याच रांगा घेतल्या जातील)",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Excel File",
              "fieldType": "file",
              "requiredField": true,
              "acceptFileTypes": ".xlsx"
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "फाईल मिळाली — काम सुरू झाले आहे. सर्व titles पूर्ण झाल्यावर output फोल्डरमधली Word फाईल आपोआप उघडेल. हा tab आता बंद करू शकता."
            }
          }
        }
      },
      "id": "upload-excel",
      "name": "Upload Excel",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -620,
        300
      ],
      "webhookId": "b1b2c3d4-0001-4000-8000-000000000011"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $binary['Excel_File'].fileExtension }}",
              "rightValue": "xlsx",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "detect-excel",
      "name": "Detect Excel File",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -420,
        300
      ]
    },
    {
      "parameters": {
        "errorMessage": "अपलोड केलेली फाईल .xlsx नाही. कृपया योग्य Excel (.xlsx) फाईल अपलोड करा."
      },
      "id": "invalid-file",
      "name": "Invalid File Type",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        -220,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5959/doc/start",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ start: true }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "start-word-doc",
      "name": "Start Word Doc",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        140
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "xlsx",
        "binaryPropertyName": "Excel_File",
        "options": {}
      },
      "id": "read-excel",
      "name": "Read Excel",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        -220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ ($json.Status ?? '').toString().trim().toUpperCase() }}",
              "rightValue": "PENDING",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "f2",
              "leftValue": "={{ ($json.Title ?? '').toString().trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "pending-titles",
      "name": "Get PENDING Titles",
